module alu_tb;

parameter N = 8;

reg  [N-1:0] A, B;
reg  [2:0] opcode;
wire [N-1:0] result;
wire carry, zero, overflow, negative;

alu #(N) dut (
    .A(A),
    .B(B),
    .opcode(opcode),
    .result(result),
    .carry(carry),
    .zero(zero),
    .overflow(overflow),
    .negative(negative)
);

initial begin

    A = 8'd10; B = 8'd5;

    opcode = 3'b000; #10; // ADD
    opcode = 3'b001; #10; // SUB
    opcode = 3'b010; #10; // AND
    opcode = 3'b011; #10; // OR
    opcode = 3'b100; #10; // XOR
    opcode = 3'b101; #10; // SLL
    opcode = 3'b110; #10; // SRL
    opcode = 3'b111; #10; // SLT

    $finish;

end

endmodule

