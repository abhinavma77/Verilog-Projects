module decoder_2_4 (
    input A,
    input B,
    output Y0,
    output Y1,
    output Y2,
    output Y3
);

assign Y0 = ~A & ~B;
assign Y1 = ~A &  B;
assign Y2 =  A & ~B;
assign Y3 =  A &  B;

endmodule

  #TESTBENCH

module decoder_2_4_tb;

reg A;
reg B;
wire Y0;
wire Y1;
wire Y2;
wire Y3;

decoder_2_4 uut (
    .A(A),
    .B(B),
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3)
);

initial begin

 
    $monitor("Time=%0t A=%b B=%b | Y0=%b Y1=%b Y2=%b Y3=%b",
              $time, A, B, Y0, Y1, Y2, Y3);

    A=0; B=0; #10;
    A=0; B=1; #10;
    A=1; B=0; #10;
    A=1; B=1; #10;

    #10 $finish;
end

endmodule
