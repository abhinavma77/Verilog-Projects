module alu_4bit (
    input  [3:0] A,    
    input  [3:0] B,    
    input  [2:0] Op,   
    output reg [3:0] Result,
    output reg CarryOut,
    output reg Zero
);

reg [4:0] temp;  

always @(*) begin
    CarryOut = 0;
    Zero = 0;
    temp = 0;
    Result = 4'b0000;

    case(Op)
        3'b000: begin      
            temp = A + B;
            Result = temp[3:0];
            CarryOut = temp[4];
        end
        3'b001: begin      
            temp = A - B;
            Result = temp[3:0];
            CarryOut = temp[4];  
        end
        3'b010: Result = A & B;   
        3'b011: Result = A | B;   
        3'b100: Result = A ^ B;   
        3'b101: Result = ~A;      
        default: Result = 4'b0000;
    endcase


    if (Result == 4'b0000)
        Zero = 1;
    else
        Zero = 0;
end

endmodule

