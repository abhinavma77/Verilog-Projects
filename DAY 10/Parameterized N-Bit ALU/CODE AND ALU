module alu (
    input  [N-1:0] A,
    input  [N-1:0] B,
    input  [2:0]   opcode,
    output reg [N-1:0] result,
    output reg carry,
    output reg zero,
    output reg overflow,
    output reg negative
);

reg [N:0] temp;

always @(*) begin
    
    result   = 0;
    carry    = 0;
    overflow = 0;

    case(opcode)

        3'b000: begin  
            temp     = A + B;
            result   = temp[N-1:0];
            carry    = temp[N];
            overflow = (A[N-1] == B[N-1]) && 
                       (result[N-1] != A[N-1]);
        end

        3'b001: begin  
            temp     = A - B;
            result   = temp[N-1:0];
            carry    = temp[N];
            overflow = (A[N-1] != B[N-1]) && 
                       (result[N-1] != A[N-1]);
        end

        3'b010: result = A & B;   
        3'b011: result = A | B;   
        3'b100: result = A ^ B;  
        3'b101: result = A << 1;  
        3'b110: result = A >> 1;  
        3'b111: result = ($signed(A) < $signed(B)) ? 1 : 0; 

    endcase

    zero     = (result == 0);
    negative = result[N-1];

end


