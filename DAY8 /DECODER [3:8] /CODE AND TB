module decoder_3_8 (
    input A,
    input B,
    input C,
    output Y0,
    output Y1,
    output Y2,
    output Y3,
    output Y4,
    output Y5,
    output Y6,
    output Y7
);

assign Y0 = ~A & ~B & ~C;
assign Y1 = ~A & ~B &  C;
assign Y2 = ~A &  B & ~C;
assign Y3 = ~A &  B &  C;
assign Y4 =  A & ~B & ~C;
assign Y5 =  A & ~B &  C;
assign Y6 =  A &  B & ~C;
assign Y7 =  A &  B &  C;

endmodule

#TESTBENCH

`timescale 1ns/1ps

module decoder_3_8_tb;

reg A;
reg B;
reg C;

wire Y0;
wire Y1;
wire Y2;
wire Y3;
wire Y4;
wire Y5;
wire Y6;
wire Y7;


decoder_3_8 uut (
    .A(A),
    .B(B),
    .C(C),
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3),
    .Y4(Y4),
    .Y5(Y5),
    .Y6(Y6),
    .Y7(Y7)
);

initial begin

    $monitor("Time=%0t | A=%b B=%b C=%b | Y=%b%b%b%b%b%b%b%b",
              $time, A, B, C,
              Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0);

    A=0; B=0; C=0; #10;
    A=0; B=0; C=1; #10;
    A=0; B=1; C=0; #10;
    A=0; B=1; C=1; #10;
    A=1; B=0; C=0; #10;
    A=1; B=0; C=1; #10;
    A=1; B=1; C=0; #10;
    A=1; B=1; C=1; #10;

    #10 $finish;
end

endmodule
